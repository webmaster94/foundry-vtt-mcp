{
  "name": "@foundry-mcp/server",
  "version": "0.13.1",
  "description": "MCP server for Foundry VTT integration with Claude Desktop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node ../../scripts/clean-build.mjs server",
    "build": "npm -w @foundry-mcp/shared run build && tsc",
    "build:bundle": "npm run build && node ../../scripts/build-server-bundles.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:bundle": "node dist/index.bundle.cjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@foundry-mcp/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.0",
    "werift": "^0.24.4",
    "winston": "^3.11.0",
    "ws": "^8.21.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "foundry-vtt",
    "claude",
    "ai"
  ]
}
