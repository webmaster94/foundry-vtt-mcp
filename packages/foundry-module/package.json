    "lint:fix": "eslint src --ext .ts --fix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@league-of-foundry-developers/foundry-vtt-types": "^9.280.0"
  },
  "files": [
    "dist",
    "module.json",
    "lang",
    "styles",
    "templates"
  ]
}
