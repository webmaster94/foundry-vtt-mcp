{
  "name": "@foundry-mcp/module",
  "version": "0.12.0",
  "description": "Foundry VTT module for MCP bridge integration",
  "type": "module",
  "scripts": {
    "prebuild": "node ../../scripts/clean-build.mjs module",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --config vitest.config.ts",
