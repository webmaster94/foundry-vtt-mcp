<div class="mcp-settings-window">
  <header class="mcp-settings-window__header">
    <h2><i class="fa-solid fa-shield-halved"></i> Permissions &amp; Safety</h2>
    <p>Control write access, event delivery, and operational safeguards.</p>
  </header>

  <section class="mcp-settings-section">
    <div class="form-group mcp-settings-warning">
      <label for="mcp-write-operations">Allow Write Operations</label>
      <div class="form-fields">
        <input id="mcp-write-operations" type="checkbox" name="allowWriteOperations" {{checked settings.allowWriteOperations}}>
      </div>
      <p class="hint">Allows MCP clients to create, update, and delete world content. Reads remain available when disabled.</p>
    </div>

    <div class="form-group">
      <label for="mcp-max-actors">Maximum Actors per Request</label>
      <div class="form-fields">
        <input id="mcp-max-actors" type="number" name="maxActorsPerRequest" value="{{settings.maxActorsPerRequest}}" min="1" max="50" step="1">
      </div>
      <p class="hint">Bounds bulk actor creation to reduce accidental large changes.</p>
    </div>

    <div class="form-group">
      <label for="mcp-readonly-risky">Protect Risky Document Types</label>
      <div class="form-fields">
        <input id="mcp-readonly-risky" type="checkbox" name="readOnlyRiskyDocuments" {{checked settings.readOnlyRiskyDocuments}}>
      </div>
      <p class="hint">Keeps Setting, FogExploration, and Adventure documents read-only through MCP.</p>
    </div>

    <div class="form-group">
      <label for="mcp-audit-retention">Audit Log Retention</label>
      <div class="form-fields">
        <input id="mcp-audit-retention" type="number" name="auditRetention" value="{{settings.auditRetention}}" min="10" max="5000" step="10">
        <span class="units">entries</span>
      </div>
      <p class="hint">Number of recent MCP operations retained for review and supported undo operations.</p>
    </div>

    <div class="form-group">
      <label for="mcp-event-push">Push Game Events to MCP</label>
      <div class="form-fields">
        <input id="mcp-event-push" type="checkbox" name="enableEventPush" {{checked settings.enableEventPush}}>
      </div>
      <p class="hint">Send combat turns, chat messages, and roll results to the bounded server event buffer.</p>
    </div>
  </section>

  <footer class="mcp-settings-window__footer">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> Save Safety Settings</button>
    <button class="mcp-settings-reset" type="submit" name="_action" value="reset"><i class="fa-solid fa-rotate-left"></i> Reset Safety</button>
  </footer>
</div>
