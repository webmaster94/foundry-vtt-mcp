{
  "name": "foundry-mcp-integration",
  "version": "0.13.0",
  "description": "MCP server that bridges Foundry VTT game data with Claude Desktop",
  "private": true,
  "workspaces": [
    "packages/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/mcp-server",
    "dev:desktop": "npm run dev --workspace=@foundry-mcp/desktop",
    "clean": "node scripts/clean-build.mjs",
    "prebuild": "npm run clean",
    "build": "npm run build --workspaces --if-present",
    "build:foundry": "npm run build --workspace=packages/foundry-module",
    "build:server": "npm run build --workspace=packages/mcp-server",
    "build:shared": "npm run build --workspace=shared",
    "build:desktop": "npm run build --workspace=@foundry-mcp/desktop",
    "build:desktop-icons": "node scripts/build-desktop-icons.mjs",
    "bundle:server": "npm run build:bundle --workspace=packages/mcp-server",
    "pack:desktop:win": "npm run bundle:server && npm run pack:win --workspace=@foundry-mcp/desktop",
    "pack:desktop:mac": "npm run bundle:server && npm run pack:mac --workspace=@foundry-mcp/desktop",
    "build:release": "npm run build:shared && npm run build:server && npm run bundle:server && npm run build:foundry",
    "installer:stage": "node installer/build-nsis.js --skip-download --skip-nsis",
    "test": "npm run test:desktop-icons && npm run test --workspaces --if-present",
    "test:desktop": "npm run test --workspace=@foundry-mcp/desktop",
    "test:desktop:e2e": "npm run test:e2e --workspace=@foundry-mcp/desktop",
    "test:desktop-icons": "node scripts/check-desktop-icons.mjs",
    "lint": "eslint . --ext .ts,.js",
    "lint:desktop": "eslint packages/desktop --ext .ts,.js --quiet",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:mcp:schema": "node scripts/mcp-schema-smoke-test.mjs",
    "test:fork-contract": "node scripts/check-fork-feature-contract.mjs",
    "test:removed-features": "node scripts/check-removed-features.mjs",
    "test:installer-safety": "bash scripts/check-installer-symlink-safety.sh",
    "test:windows-installer-safety": "node installer/tests/windows-installer-safety.mjs",
    "test:windows-packaged-lifecycle": "node installer/tests/windows-packaged-lifecycle.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "smoke": "node scripts/bridge-smoke-test.mjs",
    "setup": "node scripts/install.mjs",
    "stop": "node scripts/stop-backend.mjs",
    "audit:deps": "npm audit && npm run audit --workspaces --if-present",
    "audit:unused": "npx knip",
    "audit:circular": "npx madge --circular --extensions ts packages/mcp-server/src packages/foundry-module/src shared/src",
    "size:analyze": "npm run bundle:server && npx esbuild-analyzer packages/mcp-server/dist/backend.bundle.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild-analyzer": "^0.2.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "knip": "^5.64.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "author": "Adam Dooley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webmaster94/foundry-vtt-mcp.git"
  },
  "keywords": [
    "foundry-vtt",
    "mcp",
    "claude",
    "ai",
    "tabletop",
    "rpg"
  ],
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
